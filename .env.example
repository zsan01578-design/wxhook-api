# Copy version.example.yml to version.yml for this computer; the default path is ./version.yml.
# WXHOOK_CONFIG=./version.yml
WXHOOK_SEARCH_CONFIG=./data/search.local.json
# Independent Images API profiles and temporary generated images.
# WXHOOK_IMAGE_MODEL_CONFIG=F:/wxhook/data/image-model.local.json
# WXHOOK_IMAGE_OUTPUT_DIR=F:/wxhook/data/generated-images
WXHOOK_HOST=127.0.0.1
# Optional: at least 24 random printable ASCII characters. Never commit a real token.
# WXHOOK_ADMIN_TOKEN=
# Remote hosts must be explicitly allowed; remote access also requires HTTPS and a token.
# WXHOOK_ALLOWED_HOSTS=wxhook.example.com
WXHOOK_AI_DAILY_LIMIT=1000
WXHOOK_AI_GROUP_DAILY_LIMIT=100
WXHOOK_AI_MEMBER_DAILY_LIMIT=30
WXHOOK_AI_USAGE_DB=data/ai-usage.sqlite3
WXHOOK_PORT=8000
WXHOOK_HOOK_BASE_URL=http://127.0.0.1:30001
WXHOOK_CONNECT_TIMEOUT=2
WXHOOK_READ_TIMEOUT=10
WXHOOK_MAX_BODY_BYTES=1048576
WXHOOK_CALLBACK_QUEUE_SIZE=1000
# Concurrent callback conversations; each conversation remains ordered (1-4).
WXHOOK_CALLBACK_WORKERS=4
WXHOOK_SHUTDOWN_TIMEOUT=5
WXHOOK_LOG_LEVEL=INFO
WXHOOK_ALLOWED_CALLBACK_URLS=http://127.0.0.1:8000/receiveChatBotMsg,http://localhost:8000/receiveChatBotMsg
WXHOOK_MANAGEMENT_DB=data/management.sqlite3
WXHOOK_SYNC_ENABLED=true
WXHOOK_SYNC_INTERVAL=60
WXHOOK_MEDIA_CLEANUP_ENABLED=true
# Keep this much free space for optional media writes; 0 disables the reserve.
WXHOOK_MEDIA_MIN_FREE_MB=1024
# Retention is opt-in for chat history (0 keeps forever). Reply claims and
# finished tasks/reminders are bounded by default.
# WXHOOK_CHAT_RETENTION_DAYS=0
# WXHOOK_CLAIM_RETENTION_DAYS=90
# WXHOOK_TASK_RETENTION_DAYS=180
# WXHOOK_REMINDER_RETENTION_DAYS=180
# WXHOOK_RETENTION_INTERVAL=86400
# Enable FTS5 trigram message search; false falls back to instr().
# WXHOOK_FTS_ENABLED=true
# Online database + configuration backup; defaults alongside the management DB.
WXHOOK_BACKUP_ENABLED=true
WXHOOK_BACKUP_INTERVAL=86400
WXHOOK_BACKUP_KEEP=7
WXHOOK_BACKUP_MIN_FREE_MB=1024
# WXHOOK_BACKUP_DIR=F:/wxhook-backups
# Defaults alongside the management DB, 5 MiB per file plus 3 rotated copies.
# WXHOOK_LOG_FILE=F:/wxhook/data/wxhook.log
